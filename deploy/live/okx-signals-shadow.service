# /etc/systemd/system/okx-signals-shadow.service
# Modi 每小时信号（影子模式）：与 okx-signals.service 相同的计算，但加 --shadow，只写
# /var/lib/modi-okx-signals/evolve/signals.shadow.json 与 shadow/signals-YYYY-MM-DD.jsonl，**不触发**实盘跟单，
# 交易程序也从不读这些文件（okx-live@ 仍用 fetch_signals.py 下载 GitHub 信号，线上行为不变）。
# 不进化、不发布、不写 paper-data、不持有任何密钥（不读 okx-live.env；/etc/modi-okx-live 对本服务不可见）。
# 影子期 2–3 天每 4 小时与 GitHub 发布的 signals.json 对账：docs/shadow-run-plan.md、tools/analysis/compare_signals.py。
# 也用来做首次冷缓存回填（不会触发跟单）。
# 资源限制与正式单元相同（实盘优先；超过 MemoryMax 只杀本进程）。
[Unit]
Description=Modi hourly signals, SHADOW (replay only, no keys, never triggers trading)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=modi-signals
Group=modi-signals
WorkingDirectory=/opt/modi-okx-live
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# 状态目录 0755：只有公共行情与已公开的 paper-data 推出的信号，实盘用户 modi-live 需要读取 evolve/signals.json
StateDirectory=modi-okx-signals
StateDirectoryMode=0755
ExecStart=/usr/bin/python3 tools/evolve/signals_hourly.py --data /var/lib/modi-okx-signals --candles /var/lib/modi-okx-signals/candles --shadow
# oneshot 退出后 systemd 255 不再给出 MemoryPeak（$$ = shell 的 $，%% = %）：在 cgroup 删除前把 memory.peak、CPU 与结果追加到 metrics.log（影子期验收用）
ExecStopPost=-/bin/sh -c 'echo "$$(date -u +%%FT%%TZ) unit=%n result=$$SERVICE_RESULT status=$$EXIT_STATUS memory_peak=$$(cat /sys/fs/cgroup/system.slice/%n/memory.peak 2>/dev/null) $$(grep ^usage_usec /sys/fs/cgroup/system.slice/%n/cpu.stat 2>/dev/null)" >> /var/lib/modi-okx-signals/metrics.log'
# 脚本自己按时失败：H:05（K 线，连同进行中的请求）/ H:08（资金费），其余卡死由脚本内看门狗在 H:09:30 以退出码 2 结束；
# 这里（H:11:30）只是最后的兜底，正常不会触发
TimeoutStartSec=600
# 本盒实测峰值 RSS 约 409 MiB（418 000 KB）（重放时 execution.Series 的指标缓存约 200 MB）：MemoryHigh 定在 460M（报告建议 420M，
# 会在正常运行时就被节流），MemoryMax 520M 不变；影子期用 systemctl show -p MemoryPeak 实测后再调
MemoryHigh=460M
MemoryMax=520M
CPUWeight=20
IOWeight=20
Nice=15
OOMScoreAdjust=500
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=-/etc/modi-okx-live
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
