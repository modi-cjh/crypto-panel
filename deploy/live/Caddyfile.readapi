# Caddy：只读接口的 HTTPS 入口（/etc/caddy/Caddyfile）。证书由 Let's Encrypt 自动签发（TLS-ALPN，只用 443）。
# 只转发 GET / HEAD 的三个路径到本机 127.0.0.1:8787；其它一律 404 / 405。CORS、限流在 live_readapi.py 里。
{
	auto_https disable_redirects
}

139-180-146-42.sslip.io {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	header -Server
	header Strict-Transport-Security "max-age=31536000"
	@read {
		method GET HEAD
		path /live.json /tickers.json /healthz
	}
	handle @read {
		reverse_proxy 127.0.0.1:8787
	}
	@write not method GET HEAD
	handle @write {
		header Allow "GET, HEAD"
		header Access-Control-Allow-Origin "https://modi-cjh.github.io"
		respond 405
	}
	handle {
		respond 404
	}
}
