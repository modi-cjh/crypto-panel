# Caddy：只读接口的 HTTPS 入口（/etc/caddy/Caddyfile）。证书由 Let's Encrypt 自动签发（TLS-ALPN，只用 443）。
# 只转发 GET / HEAD 的五个只读路径到本机 127.0.0.1:8787；其它一律 404 / 405。CORS、限流、参数白名单在 live_readapi.py 里。
# /stream 是 Server-Sent Events 实时推送：flush_interval -1 表示不缓冲、每条立即发出。
{
	auto_https disable_redirects
}

139-180-146-42.sslip.io {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	header -Server
	header Strict-Transport-Security "max-age=31536000"
	@stream {
		method GET
		path /stream
	}
	handle @stream {
		reverse_proxy 127.0.0.1:8787 {
			flush_interval -1
		}
	}
	@read {
		method GET HEAD
		path /live.json /tickers.json /healthz /candles
	}
	handle @read {
		reverse_proxy 127.0.0.1:8787
	}
	@write not method GET HEAD
	handle @write {
		header Allow "GET, HEAD"
		header Access-Control-Allow-Origin "https://modi-cjh.github.io"
		respond 405
	}
	handle {
		respond 404
	}
}
