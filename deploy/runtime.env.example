# Generate the real file ON THE SERVER with python -m runtime.admin configure.
# Keep it outside the checkout, root-owned mode 0600, and never commit it.
PANEL_PUBLIC_ORIGIN=https://trade.example.com
PANEL_PRIVATE_DIR=/var/lib/crypto-panel/private
PANEL_DATA_DIR=/var/lib/crypto-panel/data
PANEL_PASSWORD_HASH=REPLACE_WITH_GENERATED_PBKDF2_HASH
PANEL_EXECUTION_ENABLED=0
PANEL_CYCLE_SECONDS=300
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
PANEL_GITHUB_READ_TOKEN=
